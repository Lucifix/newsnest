<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head><title>NewsNest feed catalog</title></head>
  <!-- Browsed in Settings → Discover → Browse the catalog; picked feeds go on trial.
       Checked 2026-11-02: https, live, posting within 2 weeks, no podcasts or video.
       A topic suggests a section: a built-in key (world, tech, lifestyle) or a new one, named by
       section_label with an icon. site= names the site when the feed is hosted elsewhere (for its icon). -->
  <body>
    <outline text="World news" key="world" section="world">
      <outline type="rss" text="Al Jazeera" xmlUrl="https://www.aljazeera.com/xml/rss/all.xml" description="Global news with a view beyond the West"/>
      <outline type="rss" text="BBC News: World" xmlUrl="https://feeds.bbci.co.uk/news/world/rss.xml" description="International news from the BBC" site="https://www.bbc.com"/>
      <outline type="rss" text="CBC World" xmlUrl="https://www.cbc.ca/webfeed/rss/rss-world" description="World news from Canada's CBC"/>
      <outline type="rss" text="The Conversation" xmlUrl="https://theconversation.com/global/articles.atom" description="Academics explain the news"/>
      <outline type="rss" text="The Diplomat" xmlUrl="https://thediplomat.com/feed/" description="Politics and security in the Asia-Pacific"/>
      <outline type="rss" text="DW" xmlUrl="https://rss.dw.com/rdf/rss-en-all" description="Germany's international broadcaster" site="https://www.dw.com"/>
      <outline type="rss" text="Foreign Policy" xmlUrl="https://foreignpolicy.com/feed/" description="Analysis of global affairs"/>
      <outline type="rss" text="France 24" xmlUrl="https://www.france24.com/en/rss" description="International news from Paris"/>
      <outline type="rss" text="Global Voices" xmlUrl="https://globalvoices.org/feed/" description="Citizen reporting from around the world"/>
      <outline type="rss" text="The Guardian: World" xmlUrl="https://www.theguardian.com/world/rss" description="World news from the Guardian"/>
      <outline type="rss" text="The Hindu: International" xmlUrl="https://www.thehindu.com/news/international/feeder/default.rss" description="World news from India's The Hindu"/>
      <outline type="rss" text="The Japan Times" xmlUrl="https://www.japantimes.co.jp/feed/" description="News from Japan in English"/>
      <outline type="rss" text="Le Monde in English" xmlUrl="https://www.lemonde.fr/en/rss/une.xml" description="Le Monde's English edition"/>
      <outline type="rss" text="Meduza" xmlUrl="https://meduza.io/rss/en/all" description="Independent Russian journalism in English"/>
      <outline type="rss" text="NPR World" xmlUrl="https://feeds.npr.org/1004/rss.xml" description="World coverage from US public radio" site="https://www.npr.org"/>
      <outline type="rss" text="NYT World" xmlUrl="https://rss.nytimes.com/services/xml/rss/nyt/World.xml" description="The New York Times world desk" site="https://www.nytimes.com"/>
