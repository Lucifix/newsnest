# Copy to .env and edit:  cp .env.example .env
# Docker Compose reads .env automatically. Never commit the real .env.

# Password for the web UI. Required: with no password the app refuses all access.
NEWSNEST_PASSWORD=change-me

# Enables ranking, summaries and the weekly profile suggestions.
# Leave empty to run without AI (stories are then shown newest first).
ANTHROPIC_API_KEY=

# Time zone for schedules and "today" in the archive (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=UTC

# Where the config and the database live on this machine.
# Create the folders first (mkdir -p config data) so Docker does not create them as root.
NEWSNEST_CONFIG_PATH=./config
NEWSNEST_DATA_PATH=./data

# Port the web UI is published on, and the user the container runs as
# (run `id -u` and `id -g`; the defaults suit most single-user Linux machines).
NEWSNEST_PORT=3095
PUID=1000
PGID=1000
